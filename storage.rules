rules_version = '2';

// Règles Firebase Storage — distinctes des règles Firestore (fichier
// firestore.rules), à publier séparément dans Firebase Console.
//
// Utilisé pour l'instant uniquement pour le logo de l'établissement
// (schools/{schoolId}/logo.*). Lecture publique (le logo doit pouvoir être
// affiché sans authentification, par exemple dans un PDF généré côté
// client), écriture réservée aux utilisateurs connectés.
service firebase.storage {
  match /b/{bucket}/o {
    match /schools/{schoolId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
