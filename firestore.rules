rules_version = '2';

// Modèle : chaque utilisateur (users/{uid}) appartient à un établissement
// (schoolId). Toutes les données pédagogiques vivent sous
// schools/{schoolId}/... et ne sont accessibles qu'aux membres de cet
// établissement. Les paramètres de l'école ne sont modifiables que par le
// directeur ou un membre explicitement autorisé (canEditSchoolSettings).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToSchool(schoolId) {
      return isSignedIn() && myProfile().schoolId == schoolId;
    }

    function canEditSchool(schoolId) {
      return belongsToSchool(schoolId) &&
        (myProfile().role == 'directeur' || myProfile().canEditSchoolSettings == true);
    }

    function isStaff() {
      return myProfile().role == 'directeur' || myProfile().role == 'secretaire';
    }

    // Un enseignant ne peut écrire des notes ou des absences que pour une
    // classe/matière qui lui est assignée :
    //  - en maternelle/primaire, la classe a un seul enseignant
    //    (classes/{id}.headTeacherId) ;
    //  - au secondaire, chaque matière d'une classe a son propre
    //    enseignant (classSubjectTeachers/{classId}__{subjectId}).
    // Par sécurité et pour ne jamais bloquer un usage existant, l'écriture
    // reste autorisée quand la classe ou l'affectation n'existe pas ou
    // n'a pas encore été configurée (aucun enseignant assigné), ou quand
    // la donnée ne précise pas de matière (cas maternelle/primaire).
    function classData(schoolId, classId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)).data;
    }

    function assignmentData(schoolId, classId, subjectId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/classSubjectTeachers/$(classId + '__' + subjectId)).data;
    }

    function isAssignedTeacherForRecord(schoolId, data) {
      return !exists(/databases/$(database)/documents/schools/$(schoolId)/classes/$(data.classId)) ||
        (
          classData(schoolId, data.classId).level != 'Secondaire'
            ? (classData(schoolId, data.classId).headTeacherId == null ||
               classData(schoolId, data.classId).headTeacherId == request.auth.uid)
            : (
                !("subjectId" in data) || data.subjectId == null ||
                !exists(/databases/$(database)/documents/schools/$(schoolId)/classSubjectTeachers/$(data.classId + '__' + data.subjectId)) ||
                assignmentData(schoolId, data.classId, data.subjectId).teacherId == null ||
                assignmentData(schoolId, data.classId, data.subjectId).teacherId == request.auth.uid
              )
        );
    }

    function canWriteScoped(schoolId, data) {
      return isStaff() || (myProfile().role == 'enseignant' && isAssignedTeacherForRecord(schoolId, data));
    }

    function isScopedTeachingCollection(document) {
      return document.split('/')[0] == 'grades' || document.split('/')[0] == 'absences';
    }

    // L'emploi du temps n'est créé et modifié que par le directeur ou la
    // secrétaire — ni un enseignant, ni un parent, même si l'interface le
    // leur cachait déjà.
    function isAdminOnlyCollection(document) {
      return document.split('/')[0] == 'schedule';
    }

    // Profil utilisateur : chacun lit/modifie le sien. La création se fait
    // uniquement lors de l'inscription (createSchoolAndDirector côté app),
    // avec un schoolId qui doit correspondre à un établissement existant.
    // Profil utilisateur : chacun lit/modifie le sien. Un directeur peut en
    // plus créer, lister et révoquer les profils du personnel administratif
    // (secrétaire, autre directeur) de son propre établissement — nécessaire
    // pour la section Administration.
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isSignedIn() && myProfile().role == 'directeur' &&
        resource.data.schoolId == myProfile().schoolId;
      allow create: if isSignedIn() && (
        request.auth.uid == uid ||
        (myProfile().role == 'directeur' && request.resource.data.schoolId == myProfile().schoolId)
      );
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && myProfile().role == 'directeur' &&
        resource.data.schoolId == myProfile().schoolId;
    }

    // Établissement : lisible par ses membres, modifiable par le directeur
    // ou un membre désigné. Création libre (se fait à l'inscription).
    match /schools/{schoolId} {
      allow read: if belongsToSchool(schoolId);
      allow create: if isSignedIn();
      allow update: if canEditSchool(schoolId);

      // Données pédagogiques : accessibles à tout membre de l'établissement,
      // à l'exception de l'écriture sur "grades" (notes) et "absences",
      // restreinte à l'enseignant assigné (ou au personnel de
      // direction/secrétariat). Le wildcard récursif couvre aussi les
      // sous-collections profondes comme conversations/{uid}/messages,
      // utilisées par la messagerie.
      match /{document=**} {
        allow read: if belongsToSchool(schoolId);
        allow create, update: if belongsToSchool(schoolId) && (
          (isScopedTeachingCollection(document) && canWriteScoped(schoolId, request.resource.data)) ||
          (isAdminOnlyCollection(document) && isStaff()) ||
          (!isScopedTeachingCollection(document) && !isAdminOnlyCollection(document))
        );
        allow delete: if belongsToSchool(schoolId) && (
          isStaff() ||
          (!isScopedTeachingCollection(document) && !isAdminOnlyCollection(document))
        );
      }
    }

    // Invitations parent : un membre du personnel crée un code pour un
    // élève de son établissement. N'importe quel utilisateur connecté peut
    // lire un code précis (il doit le connaître, il ne peut pas les lister)
    // et le marquer comme utilisé lors de la création de son compte parent.
    match /parentInvitations/{code} {
      allow read: if isSignedIn();
      allow create: if belongsToSchool(request.resource.data.schoolId);
      allow update: if isSignedIn() && resource.data.used == false;
    }
  }
}
