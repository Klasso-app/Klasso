rules_version = '2';

// Modèle : chaque utilisateur (users/{uid}) appartient à un établissement
// (schoolId). Toutes les données pédagogiques vivent sous
// schools/{schoolId}/... et ne sont accessibles qu'aux membres de cet
// établissement. Les paramètres de l'école ne sont modifiables que par le
// directeur ou un membre explicitement autorisé (canEditSchoolSettings).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToSchool(schoolId) {
      return isSignedIn() && myProfile().schoolId == schoolId;
    }

    function canEditSchool(schoolId) {
      return belongsToSchool(schoolId) &&
        (myProfile().role == 'directeur' || myProfile().canEditSchoolSettings == true);
    }

    // Profil utilisateur : chacun lit/modifie le sien. La création se fait
    // uniquement lors de l'inscription (createSchoolAndDirector côté app),
    // avec un schoolId qui doit correspondre à un établissement existant.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
    }

    // Établissement : lisible par ses membres, modifiable par le directeur
    // ou un membre désigné. Création libre (se fait à l'inscription).
    match /schools/{schoolId} {
      allow read: if belongsToSchool(schoolId);
      allow create: if isSignedIn();
      allow update: if canEditSchool(schoolId);

      // Données pédagogiques : accessibles à tout membre de l'établissement.
      match /{collection}/{docId} {
        allow read, write: if belongsToSchool(schoolId);
      }
    }

    // Invitations parent : un membre du personnel crée un code pour un
    // élève de son établissement. N'importe quel utilisateur connecté peut
    // lire un code précis (il doit le connaître, il ne peut pas les lister)
    // et le marquer comme utilisé lors de la création de son compte parent.
    match /parentInvitations/{code} {
      allow read: if isSignedIn();
      allow create: if belongsToSchool(request.resource.data.schoolId);
      allow update: if isSignedIn() && resource.data.used == false;
    }
  }
}
